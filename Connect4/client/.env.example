# Leave empty for local development and single-server deployments:
# the client then talks to whatever origin served it (Vite proxies to :3001 in dev).
#
# Set this only if the API is hosted somewhere else, e.g. React on Vercel/Netlify
# and the Node server on Render/Railway:
# VITE_SERVER_URL=https://your-server.example.com
VITE_SERVER_URL=
